VITE_API_URL=http://localhost:3000

# API (keep these server-only; use distinct LOGIN users that are members of
# rf_api_staff and rf_api_admin after installing the base SQL into a new DB)
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGINS=http://localhost:5173
DEFAULT_TENANT_SLUG=imperio-de-ross
DATABASE_STAFF_URL=postgresql://ir_api_staff:CHANGE_ME@127.0.0.1:5432/imperio_ross_dev
DATABASE_ADMIN_URL=postgresql://ir_api_admin:CHANGE_ME@127.0.0.1:5432/imperio_ross_dev
DATABASE_MIGRATOR_URL=postgresql://ir_migrator:CHANGE_ME@127.0.0.1:5432/imperio_ross_dev
CLAIM_CODE_KEY=generate_a_unique_random_secret_of_at_least_32_characters
SESSION_TTL_DAYS=7

# Private proof storage (never served as a public static directory)
STORAGE_PATH=./var/private-uploads
MAX_PROOF_FILE_BYTES=5242880
