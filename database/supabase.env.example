# Copia este archivo como .local/supabase.env y completa los datos desde Supabase > Connect.
SUPABASE_PROJECT_REF=replace-with-project-ref
SUPABASE_DB_URL=postgresql://postgres.replace-with-project-ref:replace-with-url-encoded-password@replace-with-session-pooler-host:5432/postgres?sslmode=require
SUPABASE_INSTALL_EMPTY_DB=
